{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-observatory-rohan",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "assets": { "directory": "apps/worker/public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "edge-observatory", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "apps/worker/migrations" }],
  "durable_objects": { "bindings": [{ "name": "SITE", "class_name": "SiteDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteDO"] }],
  "triggers": { "crons": ["5 0 * * *", "30 3 * * *"] },
  "vars": { "QUERY_MODE": "sqlite", "ARCHIVE_MODE": "disabled", "DEFAULT_DAILY_CAP": "100", "INGEST_HOSTS": "", "COMPAT_ENDPOINT": "", "APP_HOST": "" }
  // Supply ACCESS_TEAM_DOMAIN, ACCESS_AUD and BOOTSTRAP_ADMINS as secrets.
  // No local bypass or synthetic/demo flags are present in the deployment profile.
  // No R2, paid query, logging or external API bindings are required.
}
