{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-observatory",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "apps/worker/public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "qwa", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "apps/worker/migrations" }],
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "qwa-data" }],
  "durable_objects": { "bindings": [{ "name": "SITE", "class_name": "SiteDO" }, { "name": "SCHEDULER", "class_name": "Scheduler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteDO"] }, { "tag": "v2", "new_sqlite_classes": ["Scheduler"] }],
  "vars": { "QUERY_MODE": "sqlite", "DEFAULT_DAILY_CAP": "1000", "INGEST_HOSTS": "", "COMPAT_ENDPOINT": "http://localhost:8787/api/event", "DEV_USER_EMAIL": "local@example.com", "BOOTSTRAP_ADMINS": "local@example.com" }
}
